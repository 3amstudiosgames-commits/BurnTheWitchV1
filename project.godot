"CharacterTest": "res://Dialogic/Characters/CharacterTest.dch",
"Characters/character_test": "res://Dialogic/Characters/character_test.dch"
}
directories/dtl_directory={
"Test": "res://Dialogic/Timelines/Test.dtl"
}
layout/style_directory={}

[display]

